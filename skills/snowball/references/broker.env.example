# Copy to a gitignored local `.env` (NEVER commit real keys or .pfx certificates!)

# === US Market: Alpaca Paper Trading (Free, recommended first) ===
# Sign up at https://app.alpaca.markets/ -> Paper Trading -> API Keys
ALPACA_API_KEY=PK_YOUR_PAPER_KEY_HERE
ALPACA_SECRET_KEY=YOUR_PAPER_SECRET_HERE

# === Taiwan Market: SinoPac Shioaji (Simulation Mode) ===
# Apply at https://www.sinotrade.com.tw/ -> Shioaji API
SHIOAJI_API_KEY=YOUR_SHIOAJI_API_KEY
SHIOAJI_SECRET_KEY=YOUR_SHIOAJI_SECRET_KEY
# Only required when switching from simulation to live trading:
SHIOAJI_CA_PATH=/path/to/your/Sinopac.pfx
SHIOAJI_CA_PASSWORD=YOUR_CA_PASSWORD

# === Safety Override (DO NOT set unless you are 100% ready for real-money orders) ===
# SNOWBALL_ALLOW_LIVE_ORDERS=YES_I_UNDERSTAND
